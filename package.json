{
  "name": "capstone-video-editor",
  "version": "0.1.0",
  "description": "Apexiel capstone — desktop review-and-cut editor for AI-assisted motorsports video indexing",
  "author": "Apexiel Capstone Team",
  "main": "main.js",
  "scripts": {
    "setup": "node scripts/setup.js",
    "start": "electron .",
    "test": "node --test --test-isolation=none",
    "pack:mac": "electron-builder --mac --dir",
    "installer:mac": "electron-builder --mac dmg",
    "pack:win": "node scripts/pack-win.js",
    "installer:win": "node scripts/installer-win.js"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.15.3"
  }
}
